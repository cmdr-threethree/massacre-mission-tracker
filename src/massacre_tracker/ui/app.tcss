Screen {
    background: $surface;
}

Header {
    background: $boost;
    color: $text;
}

#status-bar {
    height: 2;
    padding: 0 1;
    background: $panel;
    border-bottom: solid $primary-darken-2;
}

#status-line {
    height: 1;
    color: $text-muted;
    overflow: hidden;
    text-overflow: ellipsis;
}

#warnings-line {
    height: 1;
    color: $warning;
    overflow: hidden;
    text-overflow: ellipsis;
}

#controls {
    height: 3;
    padding: 0 1;
    align: left middle;
}

.control-label {
    width: auto;
    margin: 0 1 0 0;
    content-align: left middle;
    color: $text-muted;
}

#commander-select {
    width: 26;
    margin: 0 1 0 0;
}

#view-select {
    width: 13;
    margin: 0 1 0 0;
}

#sort-label {
    width: auto;
    content-align: left middle;
    color: $text-muted;
}

#empty-message {
    height: 1;
    padding: 0 1;
    color: $text-muted;
}

#missions {
    height: 1fr;
    min-height: 4;
    scrollbar-size: 1 1;
}

#details {
    height: 32%;
    min-height: 6;
    max-height: 12;
    border-top: solid $primary-darken-2;
}

TabPane {
    padding: 0;
    height: 1fr;
}

#stacks-table,
#targets-table,
#bounties-table,
#sessions-table {
    height: 1fr;
    scrollbar-size: 1 1;
}

#clipboard-text {
    height: 1fr;
    padding: 0 1;
    overflow-y: auto;
}

.hidden {
    display: none;
}

/* ---------------------------------------------------------------- */
/* Modal dialogs                                                     */
/* ---------------------------------------------------------------- */

ConfirmScreen,
HelpScreen,
ClipboardScreen,
CopyMenuScreen,
MissingDirectoryScreen {
    align: center middle;
}

.dialog {
    width: 72;
    height: auto;
    max-height: 85%;
    padding: 1 2;
    border: thick $primary;
    background: $surface;
}

.wide-dialog {
    width: 78;
    max-width: 95%;
    height: auto;
    max-height: 85%;
}

.dialog-title {
    text-style: bold;
    color: $accent;
    margin-bottom: 1;
}

.dialog-buttons {
    height: auto;
    margin-top: 1;
    align: right middle;
}

.dialog-buttons Button {
    margin-left: 1;
}

.vertical-buttons {
    height: auto;
    align: left middle;
}

.vertical-buttons Button {
    width: 100%;
    margin: 1 0 0 0;
}

#help-body,
#clipboard-body {
    height: 1fr;
    min-height: 8;
    max-height: 18;
    margin-bottom: 1;
}

#confirm-prompt {
    height: auto;
}
